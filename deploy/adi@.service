[Unit]
Description=Adi simulation instance %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/adi
ExecStart=/opt/adi/venv/bin/python /opt/adi/run.py --instance %i
Restart=always
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
